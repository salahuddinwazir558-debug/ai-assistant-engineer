<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Portfolio</title>
    <style>
        /* Basic Reset */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f4f4f4;
            color: #333;
            line-height: 1.6;
        }

        header {
            background-color: #0077cc;
            color: white;
            padding: 20px 0;
            text-align: center;
        }

        header h1 {
            font-size: 2em;
        }

        nav {
            margin-top: 10px;
        }

        nav a {
            color: white;
            margin: 0 15px;
            text-decoration: none;
            font-weight: bold;
        }

        section {
            padding: 40px 20px;
            max-width: 800px;
            margin: auto;
        }

        section h2 {
            margin-bottom: 20px;
            color: #0077cc;
        }

        .projects {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .project {
            background-color: white;
            padding: 20px;
            flex: 1 1 250px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }

        footer {
            text-align: center;
            padding: 20px;
            background-color: #0077cc;
            color: white;
            margin-top: 40px;
        }

        button {
            background-color: #0077cc;
            color: white;
            border: none;
            padding: 10px 15px;
            cursor: pointer;
            border-radius: 5px;
        }

        button:hover {
            background-color: #005fa3;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>Your Name</h1>
        <nav>
            <a href="#about">About</a>
            <a href="#projects">Projects</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <!-- About Section -->
    <section id="about">
        <h2>About Me</h2>
        <p>Hello! I am a passionate developer learning web development. I love building projects and solving problems with code.</p>
    </section>

    <!-- Projects Section -->
    <section id="projects">
        <h2>Projects</h2>
        <div class="projects">
            <div class="project">
                <h3>Calculator</h3>
                <p>A simple calculator built with Python and JavaScript.</p>
                <button onclick="alert('Project link coming soon!')">View Project</button>
            </div>
            <div class="project">
                <h3>Portfolio Website</h3>
                <p>This personal portfolio website template you are viewing.</p>
                <button onclick="alert('Project link coming soon!')">View Project</button>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact">
        <h2>Contact Me</h2>
        <p>Feel free to reach out via email or social media!</p>
        <button onclick="alert('Email: yourname@example.com')">Email Me</button>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 Your Name. All Rights Reserved.</p>
    </footer>

</body>
</html>
